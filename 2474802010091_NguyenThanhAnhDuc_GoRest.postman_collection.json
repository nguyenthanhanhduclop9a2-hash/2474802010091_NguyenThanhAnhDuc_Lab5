  "item": [
    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "1 - Create User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let requestJson;",
                  "let responseJson;",
                  "let requestParseError;",
                  "let responseParseError;",
                  "",
                  "try {",
                  "    const resolvedRawBody = pm.variables.replaceIn(pm.request.body.raw);",
                  "    requestJson = JSON.parse(resolvedRawBody);",
                  "} catch (error) {",
                  "    requestParseError = error;",
                  "}",
                  "",
                  "try {",
                  "    responseJson = pm.response.json();",
                  "} catch (error) {",
                  "    responseParseError = error;",
                  "}",
                  "",
                  "const isResponseObject =",
                  "    !responseParseError &&",
                  "    responseJson !== null &&",
                  "    typeof responseJson === \"object\" &&",
                  "    !Array.isArray(responseJson);",
                  "",
                  "pm.test(\"Status 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Raw request body là JSON hợp lệ\", function () {",
                  "    pm.expect(requestParseError, requestParseError && requestParseError.message).to.be.undefined;",
                  "});",
                  "",
                  "pm.test(\"Response body là JSON hợp lệ\", function () {",
                  "    pm.expect(responseParseError, responseParseError && responseParseError.message).to.be.undefined;",
                  "});",
                  "",
                  "pm.test(\"Response có id\", function () {",
                  "    pm.expect(isResponseObject, \"Response phải là JSON object\").to.be.true;",
                  "    pm.expect(responseJson).to.have.property(\"id\");",
                  "});",
                  "",
                  "[\"name\", \"gender\", \"email\", \"status\"].forEach(function (field) {",
                  "    pm.test(`Response ${field} khớp raw request body`, function () {",
                  "        pm.expect(requestParseError, requestParseError && requestParseError.message).to.be.undefined;",
                  "        pm.expect(isResponseObject, \"Response phải là JSON object\").to.be.true;",
                  "        pm.expect(responseJson).to.have.property(field);",
                  "        pm.expect(responseJson[field]).to.eql(requestJson[field]);",
                  "    });",
                  "});",
                  "",
                  "if (",
                  "    pm.response.code === 201 &&",
                  "    isResponseObject &&",
                  "    responseJson.id !== undefined &&",
                  "    responseJson.id !== null",
                  ") {",
                  "    pm.environment.set(\"userId\", responseJson.id);",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "inherit"
            },
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Nguyen Van B\",\"gender\":\"male\",\"email\":\"vanB_unique_12345@example.com\",\"status\":\"active\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "description": "Generated from cURL: curl --request POST '{{baseUrl}}/users' --header 'Authorization: Bearer {{token}}' --header 'Content-Type: application/json' --data-raw '{\"name\":\"{{name}}\",\"gender\":\"{{gender}}\",\"email\":\"{{runEmail}}\",\"status\":\"{{status}}\"}'"
          },
          "response": []
        },
